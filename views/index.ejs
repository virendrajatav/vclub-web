<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VClub - Premium Gaming Marketplace</title>
    <script src="https://tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cloudflare.com">
    <style>
        body { background-color: #0f172a; color: #f8fafc; }
        .game-card { transition: transform 0.2s; }
        .game-card:hover { transform: translateY(-5px); }
    </style>
</head>
<body>

    <!-- नेविगेशन बार -->
    <nav class="bg-slate-900 border-b border-slate-800 p-4 sticky top-0 z-50">
        <div class="container mx-auto flex justify-between items-center">
            <a href="/" class="text-2xl font-bold text-indigo-500 tracking-wider">VCLUB</a>
            <div class="flex items-center space-x-4">
                <a href="/" class="hover:text-indigo-400">होम</a>
                <a href="/admin/login" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-semibold transition">एडमिन लॉगिन</a>
            </div>
        </div>
    </nav>

    <!-- हीरो सेक्शन (बैनर) -->
    <header class="py-16 bg-gradient-to-b from-indigo-950/50 to-slate-900 text-center px-4">
        <h1 class="text-4xl md:text-6xl font-extrabold mb-4 tracking-tight">प्रीमियम <span class="text-indigo-500">गेमिंग मार्केटप्लेस</span></h1>
        <p class="text-slate-400 text-lg max-w-2xl mx-auto">यहाँ आपको मिलेंगे सबसे बेहतरीन गेमिंग अकाउंट्स, टॉप-अप्स und डिजिटल आइटम्स सबसे सुरक्षित और कम दामों में।</p>
    </header>

    <!-- प्रॉडक्ट्स / लिस्टिंग्स सेक्शन -->
    <main class="container mx-auto px-4 py-12">
        <h2 class="text-2xl font-bold mb-8 border-l-4 border-indigo-500 pl-3">ताज़ा लिस्टिंग्स (Latest Items)</h2>
        
        <% if (listings.length === 0) { %>
            <div class="text-center py-12 bg-slate-900/50 border border-slate-800 rounded-2xl">
                <p class="text-slate-500 text-lg">अभी कोई आइटम उपलब्ध नहीं है। एडमिन पैनल से नए आइटम जोड़ें।</p>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                <% listings.forEach(item => { %>
                    <div class="game-card bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl flex flex-col justify-between">
                        <div>
                            <img src="<%= item.image || 'https://placeholder.com' %>" alt="<%= item.title %>" class="w-full h-48 object-cover">
                            <div class="p-5">
                                <span class="text-xs font-semibold tracking-wider text-indigo-400 uppercase bg-indigo-950 px-2.5 py-1 rounded-md"><%= item.category %></span>
                                <h3 class="text-xl font-bold mt-3 mb-2 text-slate-100"><%= item.title %></h3>
                                <p class="text-slate-400 text-sm line-clamp-2 mb-4"><%= item.description %></p>
                            </div>
                        </div>
                        <div class="p-5 pt-0 border-t border-slate-800/50 flex justify-between items-center mt-auto">
                            <span class="text-2xl font-black text-emerald-400">₹<%= item.price %></span>
                            <a href="/listing/<%= item.id %>" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold px-4 py-2 rounded-xl transition">देखें / खरीदें</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </main>

    <!-- फुटर -->
    <footer class="bg-slate-950 border-t border-slate-900 py-6 text-center text-slate-600 text-sm">
        <p>&copy; 2026 VClub Marketplace. All Rights Reserved.</p>
    </footer>

</body>
</html>

