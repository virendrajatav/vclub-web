<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= listing.title %> - VClub</title>
    <script src="https://tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col">

    <!-- नेविगेशन बार -->
    <nav class="bg-slate-900 border-b border-slate-800 p-4">
        <div class="container mx-auto flex justify-between items-center">
            <a href="/" class="text-2xl font-bold text-indigo-500 tracking-wider">VCLUB</a>
            <a href="/" class="text-indigo-400 hover:text-indigo-300">← वापस होम पर</a>
        </div>
    </nav>

    <!-- प्रॉडक्ट डिटेल्स -->
    <main class="container mx-auto px-4 py-12 flex-grow max-w-4xl">
        <div class="bg-slate-950 border border-slate-800 rounded-3xl overflow-hidden shadow-2xl md:flex">
            <div class="md:w-1/2">
                <img src="<%= listing.image || 'https://placeholder.com' %>" alt="<%= listing.title %>" class="w-full h-full object-cover min-h-[300px]">
            </div>
            <div class="p-8 md:w-1/2 flex flex-col justify-between">
                <div>
                    <span class="text-xs font-semibold tracking-wider text-indigo-400 uppercase bg-indigo-950 px-2.5 py-1 rounded-md"><%= listing.category %></span>
                    <h1 class="text-3xl font-extrabold mt-4 mb-2"><%= listing.title %></h1>
                    <p class="text-slate-400 text-sm leading-relaxed mb-6"><%= listing.description %></p>
                </div>
                
                <div class="border-t border-slate-800 pt-6">
                    <div class="flex items-center justify-between mb-6">
                        <span class="text-slate-400 font-medium">कीमत:</span>
                        <span class="text-3xl font-black text-emerald-400">₹<%= listing.price %></span>
                    </div>
                    <!-- खरीदने का बटन जो व्हाट्सएप पर ले जाएगा -->
                    <a href="https://wa.me, I want to buy: <%= encodeURIComponent(listing.title) %> (ID: <%= listing.id %>)" target="_blank" class="w-full block text-center bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold py-3.5 rounded-xl transition shadow-lg shadow-emerald-500/10">
                        <i class="fab fa-whatsapp mr-2"></i> अभी खरीदें (WhatsApp)
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- फुटर -->
    <footer class="bg-slate-950 border-t border-slate-900 py-6 text-center text-slate-600 text-sm">
        <p>&copy; 2026 VClub Marketplace. All Rights Reserved.</p>
    </footer>

</body>
</html>

